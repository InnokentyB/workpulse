# Server-only Google OAuth credentials. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:13002/api/calendar/google/callback
# At least 32 random characters; used only on the server to encrypt local session cookies.
CALENDAR_SESSION_SECRET=
# For standalone/proxied personal use, set the exact browser-visible origin.
# Must match GOOGLE_CALENDAR_REDIRECT_URI origin. Root Compose defaults to13002;
# owner-review preview uses13001. Do not use a temporary Codex browser port.
WORKPULSE_PUBLIC_ORIGIN=http://127.0.0.1:13002
