# Optional server-only Google OAuth credentials for the future live calendar
# connection. The current public beta stays fully usable when these are empty.
# Never prefix credentials or tokens with NEXT_PUBLIC_.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Generate with `openssl rand -base64 32`. Keep stable across deploys or existing
# encrypted calendar sessions will be disconnected.
CALENDAR_SESSION_SECRET=

# Used only by `npm run smoke`; it is not read by the application.
# Production and preview values must use HTTPS so browser camera access works.
APP_BASE_URL=http://localhost:3000
