{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workpulse.local/workouts.schema.json",
  "title": "WorkPulse workout settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repeatCooldownMinutes", "transitionBufferSeconds", "workouts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "repeatCooldownMinutes": {
      "type": "integer",
      "minimum": 0,
      "description": "How long a completed workout is excluded from recommendations."
    },
    "transitionBufferSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Time protected before the next meeting after an exercise ends."
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "durationSeconds",
          "instructions",
          "sessionType",
          "steps",
          "selection"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "durationSeconds": { "type": "integer", "minimum": 1 },
          "instructions": { "type": "string", "minLength": 1 },
          "sessionType": {
            "enum": ["timer", "camera-neck"],
            "description": "Use timer for data-only additions. camera-neck is reserved for the implemented neck detector."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "guidance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "safetyWarning", "steps"],
            "properties": {
              "position": { "enum": ["seated", "standing", "either"] },
              "safetyWarning": { "type": "string", "minLength": 1 },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "durationSeconds"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "durationSeconds": { "type": "integer", "minimum": 1 },
                    "visual": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "src", "alt"],
                      "properties": {
                        "kind": { "enum": ["image", "animation"] },
                        "src": { "type": "string", "minLength": 1 },
                        "alt": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumMinutesSinceLastActivity"],
            "properties": {
              "minimumMinutesSinceLastActivity": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
